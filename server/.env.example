# ── Supabase (cloud PostgreSQL) ───────────────────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. In "Project Settings → Database → Connection strings", grab the two URLs:
#
#    DATABASE_URL = the "Transaction" (pooler) URL — add "?pgbouncer=true&connection_limit=1"
#    DIRECT_URL    = the "Session" / direct connection URL (used by prisma migrate)
#
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"

# ── App configuration ─────────────────────────────────────────────────────────
# JWT_SECRET MUST be the Supabase project JWT secret (Project Settings -> API).
# The backend verifies Supabase Auth access tokens (HS256) with this secret.
JWT_SECRET="your-supabase-project-jwt-secret"
JWT_EXPIRES_IN="7d"
PORT=5000
CORS_ORIGIN="http://localhost:5173"

# ── AI (Google Gemini) — free tier, required for the AI-assisted onboarding chat ─
# Get a free key at https://aistudio.google.com/apikey (free tier, no card needed).
GEMINI_API_KEY=""
# Optional: override the default model used for the chat.
GEMINI_MODEL="gemini-3.6-flash"

# ── Optional external services — leave blank to use local stubs ───────────────
RESEND_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
CLOUDINARY_URL=""
CLOUDINARY_CLOUD=""
